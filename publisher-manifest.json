);padding:12px 18px;font-size:15px;font-weight:700;line-height:1.6;border-radius:16px 16px 16px 3px}\n  .qa .a{align-self:flex-end;max-width:min(100%,660px);background:var(--cream-deep);padding:14px 18px;font-size:14.5px;color:var(--ink-soft);line-height:1.75;border-radius:16px 16px 3px 16px;border-left:2px solid var(--mark)}\n  .qa .a p{margin:0 0 8px}\n  .qa .a p:last-child{margin-bottom:0}\n\n  /* ---------- 结语 ---------- */\n  .closing{padding:60px 0 72px;border-bottom:none;background:var(--ink);color:var(--cream)}\n  .closing .wrap{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:48px;align-items:end}\n  .closing h2{font-size:clamp(22px,3vw,30px);margin:0 0 14px;font-weight:800;line-height:1.3}\n  .closing p{margin:0;color:#cfd8d0;font-size:14.5px;max-width:560px}\n  .closing .meta{font-size:12.5px;color:#9fb0a6;letter-spacing:.05em;line-height:1.9}\n  .closing .meta strong{display:block;color:var(--cream);font-size:13px;letter-spacing:.2em;margin-bottom:8px;font-weight:700}\n  .closing a{color:var(--cream);border-bottom-color:#6d8078}\n\n  @media (max-width:760px){\n    .hero{padding:44px 0 40px}\n    .hero-grid{grid-template-columns:1fr;gap:32px}\n    .hero-cols{columns:1}\n    section{padding:48px 0}\n    .plans{grid-template-columns:1fr;border-top:1px solid var(--ink)}\n    .plan:nth-child(odd),.plan:nth-child(even),.plan.is-featured{padding-left:0;padding-right:0}\n    .plan:nth-child(even){border-left:none}\n    .plan.is-featured{padding-left:20px;padding-right:20px}\n    .closing .wrap{grid-template-columns:1fr;gap:32px}\n    .client{padding-right:0}\n    .qa .a{margin-left:0}\n  }\n</style><header class=\"topbar\">\n  <div class=\"topbar-inner\">\n    <a class=\"brandmark\" href=\"#\">INSNOW</a>\n    <nav>\n      <a href=\"#plans\">套餐对照</a>\n      <a href=\"#guide\">使用说明</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</header>\n\n<main>\n\n  <section class=\"hero\">\n    <div class=\"wrap\">\n      <p class=\"hero-label\">订阅说明 · 第 3444 号文本</p>\n      <h1>INSNOW\n        <span class=\"thin\">一份写给自己看的订阅说明书</span>\n      </h1>\n\n      <div class=\"hero-grid\">\n        <div class=\"hero-cols\">\n          <p>INSNOW 的服务说明写在前面，是因为大多数关于订阅的疑问，其实都可以在开始之前被回答清楚。这份文本按顺序讲三件事：提供什么、怎么用、遇到问题如何处理。</p>\n          <p>我们不把产品描述成某种奇迹。订阅是一份按周期生效的服务约定，价格、流量额度、同时在线设备数量都写在套餐表里，没有隐藏的第二层解释。</p>\n          <p>所有条款都在下方正文中一次性陈列。你可以先看套餐对照，再决定是否继续往下读；反过来读也没有关系，说明书写给所有人。</p>\n          <p>如果某一条表述与你的实际体验不一致，请把它记下来，通过工单反馈。我们不承诺立刻修正，但会记录每一次偏差。</p>\n        </div>\n\n        <aside class=\"hero-note\">\n          <h2>文档概要</h2>\n          <dl>\n            <dt>服务名称</dt>\n            <dd>INSNOW 订阅</dd>\n            <dt>套餐数量</dt>\n            <dd>三档，两栏对照呈现</dd>\n            <dt>计费方式</dt>\n            <dd>按月或按年</dd>\n            <dt>同时在线</dt>\n            <dd>3 / 5 / 20 台</dd>\n            <dt>变更方式</dt>\n            <dd>通过工单申请</dd>\n          </dl>\n        </aside>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <p class=\"kit\">套餐</p>\n        <h2>三档订阅，两栏并列阅读</h2>\n        <p>以下价格与权益为本页陈列的全部内容。基础版与旗舰版并列排列，团队版单独成一行，避免同一视线上出现三种不同的比较基准。标记推荐的是旗舰版，理由是它在流量与设备数量之间给出了较居中的比例。</p>\n      </div>\n\n      <div class=\"plans\">\n        <article class=\"plan\">\n          <h3>基础版</h3>\n          <p class=\"price\">¥15<span> / 月</span></p>\n          <p class=\"annual\">按年付 ¥150 / 年</p>\n          <ul>\n            <li>每月 100GB 流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </article>\n\n        <article class=\"plan is-featured\">\n          <span class=\"plan-flag\">推荐</span>\n          <h3>旗舰版</h3>\n          <p class=\"price\">¥35<span> / 月</span></p>\n          <p class=\"annual\">按年付 ¥350 / 年</p>\n          <ul>\n            <li>每月 300GB 流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线优化线路</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n        </article>\n\n        <article class=\"plan\">\n          <h3>团队版</h3>\n          <p class=\"price\">¥85<span> / 月</span></p>\n          <p class=\"annual\">按年付 ¥850 / 年</p>\n          <ul>\n            <li>每月 1000GB 流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>高带宽节点池</li>\n            <li>支持自定义路由</li>\n            <li>专属客户经理对接</li>\n          </ul>\n        </article>\n\n        <div class=\"plan-foot\">\n          <p>价格与权益以上表为准。年付金额为一次性支付形式，折算后与月付的差额已直接体现在数字中，不另设隐藏优惠。订阅变更、升级与周期调整请通过工单说明。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"guide\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <p class=\"kit\">使用说明</p>\n        <h2>从订阅到可用，共四步</h2>\n        <p>以下步骤按顺序执行。任何一步无法完成时，请先不要重复尝试，直接记录现象并提交工单，比反复操作更容易定位问题。</p>\n      </div>\n\n      <div class=\"steps\">\n        <div class=\"step\">\n          <span class=\"num\">步骤 01</span>\n          <h3>确认套餐与周期</h3>\n          <p>对照上表确认所需流量额度、同时在线设备数量与计费周期。设备数量是并发上限，不是可注册设备总数。</p>\n        </div>\n        <div class=\"step\">\n          <span class=\"num\">步骤 02</span>\n          <h3>取得订阅凭据</h3>\n          <p>订阅生效后，你会获得用于客户端的订阅信息。这是一段凭据，请勿公开转发，也不要在公开页面中张贴。</p>\n        </div>\n        <div class=\"step\">\n          <span class=\"num\">步骤 03</span>\n          <h3>在客户端载入</h3>\n          <p>选择下方与你的系统对应的客户端，按客户端内的导入方式填入订阅信息，随后刷新一次配置列表。</p>\n        </div>\n        <div class=\"step\">\n          <span class=\"num\">步骤 04</span>\n          <h3>核对可用状态</h3>\n          <p>确认客户端显示的剩余流量与当期额度一致，以及当前在线设备数量未超出套餐上限。两者一致即视为配置完成。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <p class=\"kit\">客户端</p>\n        <h2>按系统选择，不做兼容性承诺</h2>\n        <p>INSNOW 不自建客户端。下列分类仅说明哪些系统上通常可运行支持订阅导入的通用客户端，具体版本、功能与可用性由各客户端自身决定。本页不提供下载地址，请自行从可信渠道获取。</p>\n      </div>\n\n      <div class=\"clients\">\n        <div class=\"client\">\n          <h3>Windows</h3>\n          <p>使用支持订阅导入的桌面客户端。导入后需在客户端内手动刷新订阅，配置才会更新。</p>\n          <span class=\"tag\">桌面端 · 非官方提供</span>\n        </div>\n        <div class=\"client\">\n          <h3>macOS</h3>\n          <p>使用支持订阅导入的桌面客户端。首次运行时系统可能要求确认网络权限，属常规提示。</p>\n          <span class=\"tag\">桌面端 · 非官方提供</span>\n        </div>\n        <div class=\"client\">\n          <h3>Android</h3>\n          <p>使用支持订阅导入的移动客户端。建议在导入后检查一次电量与后台运行限制设置。</p>\n          <span class=\"tag\">移动端 · 非官方提供</span>\n        </div>\n        <div class=\"client\">\n          <h3>iOS / iPadOS</h3>\n          <p>使用 App 商店中支持订阅导入的客户端。可用客户端与所在地区商店相关，本页不作列举。</p>\n          <span class=\"tag\">移动端 · 非官方提供</span>\n        </div>\n        <div class=\"client\">\n          <h3>路由器与软路由</h3>\n          <p>部分固件支持订阅导入。此项属于进阶配置，操作前请备份原有配置，避免影响局域网内其他设备。</p>\n          <span class=\"tag\">进阶 · 非官方提供</span>\n        </div>\n        <div class=\"client\">\n          <h3>订阅信息管理</h3>\n          <p>订阅信息等同于凭据。需要更换或重置时，请通过工单提出，不要在公开渠道讨论具体内容。</p>\n          <span class=\"tag\">凭据 · 请妥善保管</span>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <p class=\"kit\">常见问题</p>\n        <h2>逐条回答，不绕开问题</h2>\n        <p>下面三组问题按阅读顺序排列：订阅与计费、使用与配置、安全与支持。每条回答都写到可以独立理解的完整程度。</p>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>一 · 订阅与计费</h3>\n\n        <div class=\"qa\">\n          <div class=\"q\">月付和年付，除了价格还有什么区别？</div>\n          <div class=\"a\">\n            <p>仅计费周期与支付总额不同。三档套餐的年付金额分别为 ¥150、¥350、¥850，对应的月付金额为 ¥15、¥35、¥85。流量额度与设备数量不因计费周期变化。</p>\n          </div>\n        </div>\n\n        <div class=\"qa\">\n          <div class=\"q\">“同时在线 3 台”是怎么计算的？</div>\n          <div class=\"a\">\n            <p>指同一时刻处于在线状态的设备数量上限。关闭客户端或断开连接的设备不计入。基础版为 3 台，旗舰版为 5 台，团队版为 20 台。此数值不表示可以注册的设备总数。</p>\n          </div>\n        </div>\n\n        <div class=\"qa\">\n          <div class=\"q\">流量用完了会怎样？</div>\n          <div class=\"a\">\n            <p>当期流量额度用尽后，当期服务不再继续提供，需等待下一计费周期重置，或通过工单申请调整套餐。本页不对额度用尽后的具体处理方式作额外承诺。</p>\n          </div>\n        </div>\n\n        <div class=\"qa\">\n          <div class=\"q\">可以中途升级套餐吗？</div>\n          <div class=\"a\">\n            <p>可以提出申请。请通过工单说明当前套餐与目标套餐，费用差额与生效时间的处理方式以工单回复的内容为准。本页不代为说明具体折算规则。</p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>二 · 使用与配置</h3>\n\n        <div class=\"qa\">\n          <div class=\"q\">为什么导入订阅后配置列表是空的？</div>\n          <div class=\"a\">\n            <p>最常见的原因是订阅信息不完整或复制时带入多余字符。请重新核对一遍凭据内容，再在客户端内执行一次刷新。若仍为空，请记录客户端名称与操作时间后提交工单。</p>\n          </div>\n        </div>\n\n        <div class=\"qa\">\n          <div class=\"q\">INSNOW 有自己的客户端吗？</div>\n          <div class=\"a\">\n            <p>没有。INSNOW 不开发也不分发客户端，本页的客户端说明仅用于指出哪些系统上通常可运行支持订阅导入的通用客户端。客户端的版本、功能与可用性由其自身维护者决定。</p>\n          </div>\n        </div>\n\n        <div class=\"qa\">\n          <div class=\"q\">可以在同一台设备上切换不同套餐吗？</div>\n          <div class=\"a\">\n            <p>设备与套餐之间的对应关系由订阅本身决定，而非设备数量。切换套餐属于订阅变更，需通过工单处理，客户端侧只需在变更后刷新一次订阅。</p>\n          </div>\n        </div>\n\n        <div class=\"qa\">\n          <div class=\"q\">IPLC 专线优化具体指什么？</div>\n          <div class=\"a\">\n            <p>该表述对应旗舰版与团队版套餐中的线路类型说明。本页不提供关于线路性能的量化承诺，也不对特定用途的适用性作出保证。实际体验受本地网络与所处位置影响。</p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>三 · 安全与支持</h3>\n\n        <div class=\"qa\">\n          <div class=\"q\">订阅信息可以分享给朋友吗？</div>\n          <div class=\"a\">\n            <p>不建议。订阅信息等同于访问凭据，分享后你无法控制他人如何使用它。若怀疑凭据外泄，请通过工单申请更换，而不是在公开渠道讨论具体内容。</p>\n          </div>\n        </div>\n\n        <div class=\"qa\">\n          <div class=\"q\">遇到问题应该提供哪些信息？</div>\n          <div class=\"a\">\n            <p>请提供：套餐名称、客户端名称与版本、问题出现的具体时间、你所执行的操作步骤，以及现象描述。请勿在工单中粘贴完整的订阅凭据内容，必要时可只提供前后各几个字符用于定位。</p>\n          </div>\n        </div>\n\n        <div class=\"qa\">\n          <div class=\"q\">支持响应有优先级之分吗？</div>\n          <div class=\"a\">\n            <p>旗舰版在套餐说明中标明为优先工单支持，团队版配备专属客户经理对接。基础版按常规顺序处理。本页不对具体响应时长作出承诺。</p>\n          </div>\n        </div>\n\n        <div class=\"qa\">\n          <div class=\"q\">这份说明会更新吗？</div>\n          <div class=\"a\">\n            <p>会。价格、权益与说明文字可能随服务调整而变化，以本页当前呈现的内容为准。若你保存了旧版本，请以最新页面中的数字为准进行对照。</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"closing\">\n    <div class=\"wrap\">\n      <div>\n        <h2>说明书写到这里，剩下的由实际使用来检验。</h2>\n        <p>INSNOW 不附加承诺之外的形容。套餐数字、使用步骤与问题的回答都已完整写入本页，若仍有未被覆盖的情况，请通过工单提出，我们会在文档中补上对应条目。</p>\n      </div>\n      <div class=\"meta\">\n        <strong>INSNOW</strong>\n        订阅说明文档<br>\n        套餐：基础版 / 旗舰版 / 团队版<br>\n        如有疑问，请通过工单反馈\n      </div>\n    </div>\n  </section>\n\n</main>",
